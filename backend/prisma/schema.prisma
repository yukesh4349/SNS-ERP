generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  password              String
  role                  Role                   @default(parent)
  department            String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  status                UserStatus             @default(active)
  phone                 String?
  roleGroupId           String?
  roleGroup             RoleGroup?             @relation(fields: [roleGroupId], references: [id], onDelete: SetNull)
  groups                GroupMember[]
  sentMessages          Message[]              @relation("SentMessages")
  notifications         Notification[]
  fcmTokens             FCMToken[]
  announcements         Announcement[]         @relation("AnnouncementAuthor")
  studentProfile        StudentProfile?
  teacherProfile        TeacherProfile?
  profileUpdateRequests ProfileUpdateRequest[]
  leaveApplications     LeaveApplication[]
  timetableEntries      TimetableEntry[]       @relation("TeacherTimetable")
  absentSubstitutions   Substitution[]         @relation("AbsentTeacher")
  substituteSubstitutions Substitution[]       @relation("SubstituteTeacher")
}

model RoleGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model TeacherProfile {
  id             String @id @default(uuid())
  userId         String @unique
  employeeId     String @unique
  designation    String
  specialization String
  phone          String?
  dateOfBirth    String?
  weddingDate    String?
  class          String?
  section        String?
  photoUrl       String?
  canViewTransport Boolean @default(false)
  user           User   @relation(fields: [userId], references: [id])
}

model StudentProfile {
  id                   String @id @default(uuid())
  userId               String @unique
  studentId            String @unique
  class                String
  section              String
  inactiveReason       String?
  phone                String?
  photoUrl             String?
  admissionNo          String?
  applicationNo        String?
  gender               String?
  dob                  String?
  birthCertNo          String?
  nationality          String?
  religion             String?
  community            String?
  bloodGroup           String?
  presentSchool        String?
  previousGrade        String?
  boardOfEducation     String?
  motherTongue         String?
  fatherName           String?
  fatherContact        String?
  fatherEmail          String?
  fatherEducation      String?
  fatherOccupation     String?
  fatherOrganization   String?
  fatherDesignation    String?
  fatherOfficeAddress  String?
  motherName           String?
  motherContact        String?
  motherEmail          String?
  motherEducation      String?
  motherOccupation     String?
  motherOrganization   String?
  motherDesignation    String?
  motherOfficeAddress  String?
  address              String?
  user                 User   @relation(fields: [userId], references: [id])
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  messages    Message[]
}

model GroupMember {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  role      String   @default("member")
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, groupId])
}

model Message {
  id        String   @id @default(uuid())
  text      String
  senderId  String
  groupId   String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id])
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  title          String
  message        String
  type           String   @default("info") // message, alert, info
  isRead         Boolean  @default(false)
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model FCMToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  device    String?  // web, mobile
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  target    String   @default("all") // all, parents, staff
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
}

model LeaveApplication {
  id          String   @id @default(uuid())
  userId      String
  studentName String
  class       String
  section     String
  startDate   String
  endDate     String
  reason      String
  documentUrl String?
  status      String   @default("pending")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileUpdateRequest {
  id        String   @id @default(uuid())
  userId    String
  changes   Json
  status    String   @default("pending")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolSettings {
  id              String   @id @default("singleton")
  name            String   @default("SNS Academy")
  academicYear    String   @default("2026-2027")
  timezone        String   @default("Asia/Kolkata")
  contactEmail    String   @default("")
  contactPhone    String   @default("")
  address         String   @default("")
  timetableConfig Json     @default("{\"periodsCount\":8,\"lunchAfterPeriod\":4,\"timings\":[{\"period\":1,\"start\":\"08:45\",\"end\":\"09:30\"},{\"period\":2,\"start\":\"09:30\",\"end\":\"10:15\"},{\"period\":3,\"start\":\"10:15\",\"end\":\"11:00\"},{\"period\":4,\"start\":\"11:00\",\"end\":\"11:45\"},{\"period\":5,\"start\":\"12:15\",\"end\":\"13:00\"},{\"period\":6,\"start\":\"13:00\",\"end\":\"13:45\"},{\"period\":7,\"start\":\"13:45\",\"end\":\"14:30\"},{\"period\":8,\"start\":\"14:30\",\"end\":\"15:15\"}]}")
  updatedAt       DateTime @updatedAt
}

model TimetableEntry {
  id        String   @id @default(uuid())
  day       String   // Monday, Tuesday, etc.
  period    Int      // 1, 2, 3...
  startTime String
  endTime   String
  class     String
  section   String
  subject   String
  teacherId String?
  teacher   User?    @relation("TeacherTimetable", fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassTimetableConfig {
  id              String   @id @default(uuid())
  class           String
  section         String
  periodsCount    Int      @default(8)
  lunchAfterPeriod Int     @default(4)
  timings         Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([class, section])
}

model Substitution {
  id               String   @id @default(uuid())
  date             String   // YYYY-MM-DD
  period           Int
  absentTeacherId  String
  absentTeacher    User     @relation("AbsentTeacher", fields: [absentTeacherId], references: [id])
  substituteTeacherId String
  substituteTeacher User     @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  status           String   @default("pending") // pending, approved, completed
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Attendance {
  id          String   @id @default(uuid())
  studentId   String
  date        String   // YYYY-MM-DD
  status      String   // P, A, L, H
  reason      String?
  class       String
  section     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, date])
}

model TeacherAttendance {
  id          String   @id @default(uuid())
  teacherId   String
  date        String   // YYYY-MM-DD
  status      String   // P, A, L, H
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teacherId, date])
}

model Homework {
  id          String   @id @default(uuid())
  title       String
  description String
  subject     String
  dueDate     String
  class       String
  section     String
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExamResult {
  id          String   @id @default(uuid())
  studentId   String
  term        String
  subject     String
  internal    Int
  exam        Int
  total       Int
  grade       String
  remarks     String?
  academicYear String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, term, subject])
}

model ExamSchedule {
  id          String   @id @default(uuid())
  class       String
  section     String
  subject     String
  examDate    String
  startTime   String
  duration    String?
  hall        String?
  term        String
  academicYear String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromotionLog {
  id               String   @id @default(uuid())
  batchId          String   // Groups all promotions in one batch for rollback
  studentProfileId String   // FK to StudentProfile.id
  studentId        String   // The permanent student ID (never changes)
  studentName      String
  fromClass        String
  fromSection      String
  toClass          String
  toSection        String
  fromAcademicYear String   // e.g. "2025-2026"
  toAcademicYear   String   // e.g. "2026-2027"
  status           String   // promoted, failed, transferred, discontinued, graduated
  rolledBack       Boolean  @default(false)
  rolledBackAt     DateTime?
  promotedAt       DateTime @default(now())
  promotedBy       String   // admin userId who performed it
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  type        String   @default("holiday") // holiday, event, exam, meeting
  allDay      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  superadmin
  admin
  leader
  teacher
  parent
}

enum UserStatus {
  active
  away
  inactive
}
